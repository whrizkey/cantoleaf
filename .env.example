# CantoLeaf Environment Configuration (BYOK - Bring Your Own Key)
# Copy to .env and fill in your keys as needed. All providers are optional!
# - 100% Local / Offline: Extractive heuristic engine, Fake TTS, or local models
# - Zero-Key Cloud: Free Microsoft Edge TTS (no API key or account, requires internet)
# - BYOK Cloud: ElevenLabs, OpenAI, Anthropic, DeepL

# --- TTS Provider Settings ---
# Options: kokoro | piper | edge | elevenlabs | openai_compat | fake
CANTOLEAF_TTS_PROVIDER=edge
CANTOLEAF_TTS_VOICE=en-US-ChristopherNeural

# Cloud TTS Keys (Optional)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- LLM / Adaptation Settings ---
# Options: extractive | openai_compat | anthropic | deepl | fake
# Default 'extractive' requires NO API key and runs 100% offline.
CANTOLEAF_ADAPT_PROVIDER=extractive
CANTOLEAF_ADAPT_MODEL=

ANTHROPIC_API_KEY=
DEEPL_API_KEY=

# --- Budget & Safety Protection ---
# Maximum spend allowed per book run before hard circuit breaker trip (USD)
CANTOLEAF_MAX_COST_USD=5.00

# --- General ---
CANTOLEAF_CACHE_DIR=~/.cantoleaf/cache
CANTOLEAF_LOG_LEVEL=INFO
